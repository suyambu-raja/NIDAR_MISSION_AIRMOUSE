# =============================================================================
# NIDAR AirMouse — Environment Variables
# Copy this to .env and adjust values for your hardware setup
# =============================================================================

# --- ROS 2 Configuration ---
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# --- Hardware Device Paths ---
# ⚠️ HARDWARE: Verify these match your actual device paths on the RPi4
# Run `ls /dev/tty*` and `ls /dev/video*` after connecting hardware

# Pixhawk 6C — USB serial (use /dev/ttyAMA0 for UART GPIO connection)
MAVROS_FCU_URL=/dev/ttyACM0:921600

# RPLIDAR A2M8 — USB serial (use /dev/rplidar if you have udev rules)
RPLIDAR_PORT=/dev/ttyUSB0
RPLIDAR_BAUDRATE=115200

# FLIR Lepton 3.5 + PureThermal Mini Pro — UVC video device
FLIR_DEVICE=/dev/video0

# --- MAVROS Parameters ---
MAVROS_SYSTEM_ID=1
MAVROS_COMPONENT_ID=1
TAKEOFF_ALTITUDE=1.5

# --- Detection Parameters ---
OAKD_CONFIDENCE_THRESHOLD=0.5
OAKD_MODEL_PATH=/workspace/src/backend/detection_node/models/yolov8n_coco.blob
THERMAL_MIN_TEMP=30.0
THERMAL_MAX_TEMP=42.0

# --- Fusion Parameters ---
RGB_WEIGHT=0.4
THERMAL_WEIGHT=0.35
SHAPE_WEIGHT=0.15
PERSISTENCE_WEIGHT=0.10
MIN_FUSION_CONFIDENCE=0.6

# --- Tracker Parameters ---
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=3
TRACKER_IOU_THRESHOLD=0.3

# --- Exploration Parameters ---
MIN_FRONTIER_SIZE=0.5
EXPLORATION_LINEAR_SPEED=0.3
EXPLORATION_ANGULAR_SPEED=0.5
SAFETY_DISTANCE=0.5

# --- Failsafe Parameters ---
BATTERY_WARNING_PCT=30
BATTERY_CRITICAL_PCT=15
HEARTBEAT_TIMEOUT_SEC=5.0
MISSION_TIME_LIMIT_SEC=1740

# --- Corridor Classifier Parameters ---
CORRIDOR_WIDTH_THRESHOLD=2.0
MIN_SCAN_POINTS=10

# --- Grid Mapper Parameters ---
GRID_RESOLUTION=0.5
MAP_ORIGIN_X=0.0
MAP_ORIGIN_Y=0.0

# --- GCS Dashboard ---
ROSBRIDGE_PORT=9090
GCS_PORT=3000
