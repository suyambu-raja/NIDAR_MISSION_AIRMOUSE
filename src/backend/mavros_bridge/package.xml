<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mavros_bridge</name>
  <version>0.1.0</version>
  <description>
    MAVROS Bridge Node for NIDAR AirMouse.
    Connects ROS 2 to ArduPilot/Pixhawk flight controller via MAVLink/MAVROS.
    Wraps raw MAVROS telemetry, setpoint controls, arm/disarm, mode switching,
    takeoff, landing, and RTL into clean ROS 2 interfaces. Supports both
    ArduPilot SITL simulation and physical Pixhawk 6C hardware via config.
  </description>
  <maintainer email="team@nidar.dev">NIDAR Team</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime ROS 2 dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>mavros_msgs</depend>

  <!-- Custom NIDAR messages -->
  <depend>nidar_msgs</depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
