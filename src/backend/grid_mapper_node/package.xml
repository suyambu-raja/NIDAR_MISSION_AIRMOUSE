<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>grid_mapper_node</name>
  <version>0.1.0</version>
  <description>
    Grid Mapper Node for NIDAR AirMouse.
    Converts SLAM survivor positions to arena grid box IDs (e.g. "F4"),
    deduplicates survivor detections using Euclidean Distance Clustering,
    and publishes /survivor_grid_locations and /grid_map_overlay.
  </description>
  <maintainer email="team@nidar.dev">NIDAR Team</maintainer>
  <license>MIT</license>

  <!-- Build system: Python packages use ament_python -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime ROS 2 dependencies -->
  <depend>rclpy</depend>

  <!-- Standard ROS 2 message packages -->
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>

  <!-- TF2 for coordinate frame transforms (camera → map frame) -->
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Custom NIDAR messages: SurvivorArray (input), SurvivorGridArray (output) -->
  <depend>nidar_msgs</depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
