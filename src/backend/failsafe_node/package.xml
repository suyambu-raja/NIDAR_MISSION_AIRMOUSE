<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>failsafe_node</name>
  <version>0.1.0</version>
  <description>
    Failsafe Safety Supervisor Node for NIDAR AirMouse.
    Monitors battery health, MAVLink telemetry link timeouts, geofence boundaries,
    and manual abort triggers. When any condition triggers, calculates an obstacle-aware
    A* Return-to-Launch (RTL) path around indoor walls using exploration_node's PathPlanner
    and commands mavros_bridge.
  </description>
  <maintainer email="team@nidar.dev">NIDAR Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>exploration_node</depend>
  <depend>mavros_bridge</depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
