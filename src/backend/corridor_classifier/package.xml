<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>corridor_classifier</name>
  <version>0.1.0</version>
  <description>
    Corridor & Room Semantic Classifier Node for NIDAR AirMouse.
    Performs geometric analysis on SLAM 2D occupancy grids to segment and label
    connected free space into 'room', 'corridor', 'junction', and 'unclassified'
    regions for Ground Control Station (GCS) map overlay readability.
  </description>
  <maintainer email="team@nidar.dev">NIDAR Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
